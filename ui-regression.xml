<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- parallel="classes": each test class on its own thread (safe with ThreadLocal driver + per-thread My Account user). -->
<suite name="UI-Regression-Suite" verbose="1" parallel="classes" thread-count="4">
    <!-- Dinleyiciler: @Listeners ile BaseTest üzerinden -->

    <!-- 1) Public account flows (login / register / forgot password) -->
    <test name="01-Public-Account-Flows">
        <classes>
            <class name="com.automation.tests.LoginUiTest"/>
            <class name="com.automation.tests.RegisterUiTest"/>
            <class name="com.automation.tests.ForgotPasswordUiTest"/>
        </classes>
    </test>

    <!-- 2) My Account: sidebar navigation + edit profile / address book / change password -->
    <test name="02-My-Account">
        <classes>
            <class name="com.automation.tests.MyAccountUiTest"/>
            <class name="com.automation.tests.MyAccountSettingsUiTest"/>
            <class name="com.automation.tests.NewsletterUiTest"/>
        </classes>
    </test>

    <!-- 3) Storefront functional modules -->
    <test name="03-Storefront">
        <classes>
            <class name="com.automation.tests.WishListUiTest"/>
            <class name="com.automation.tests.SearchUiTest"/>
            <class name="com.automation.tests.CartUiTest"/>
            <class name="com.automation.tests.CheckoutUiTest"/>
        </classes>
    </test>

    <!-- 4) REST API layer (reqres.in) -->
    <test name="04-API-Layer">
        <classes>
            <class name="com.automation.tests.ApiTest"/>
        </classes>
    </test>

    <!-- 5) H2 in-memory DB layer -->
    <test name="05-DB-Layer">
        <classes>
            <class name="com.automation.tests.DbTest"/>
            <class name="com.automation.tests.SqlServerDbTest"/>
        </classes>
    </test>

    <!-- 6) Cross-layer E2E: UI checkout → API sync → SQL Server -->
    <test name="06-E2E-Cross-Layer">
        <classes>
            <class name="com.automation.tests.E2EOrderFlowTest"/>
        </classes>
    </test>
</suite>
